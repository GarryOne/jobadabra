# Jobadabra — local environment variables.
#
# Copy this file to `.env` and fill in real values (that file is git-ignored, never committed).
# `.env` is a fallback only: an already-exported shell variable wins over it, and on this
# maintainer's machine the macOS Keychain wins over both (see CLAUDE.md) — `.env` exists so a
# fork on Linux, Windows, or CI has something to fill in without needing Keychain at all.
#
# Everything here is read once, automatically, by src/paths.py the first time any part of this
# project imports it — no extra setup step, no library dependency.
#
# The Cloudflare Worker (worker/) is a separate deployment with its own secrets, set via
# `wrangler secret put` (see worker/setup.sh) — those are NOT read from this file.

# --- Required for anything that touches Notion (daily runs, kit drafting, apply-batch scripts) ---
NOTION_TOKEN=

# --- Required for Telegram digests (`--send`) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion database/page IDs — override these if you forked this project onto your own
#     workspace instead of the maintainer's (see README.md's Configuration section and
#     docs/notion-schema.md for what to create). Leave blank to use the maintainer's defaults,
#     which will not work for you unless you are that maintainer. ---
NOTION_APPLICATIONS_DB=
NOTION_MATCHES_DB=
NOTION_PROFILE_PAGE_ID=
NOTION_ANSWERS_PAGE_ID=
NOTION_EMPLOYERS_DB=
NOTION_AGENT_RUNS_DB=
NOTION_CRON_RUNS_DB=
NOTION_EVENTS_DB=
NOTION_INSIGHTS_DB=
NOTION_INTERVIEWS_DB=
NOTION_PIPELINE_PAGE=

# --- Optional: Google Jobs through SerpApi (paid per search; see config/search.json google_jobs) ---
SERPAPI_API_KEY=

# --- Switch optional features off without deleting their keys (see README → Optional features) ---
# Comma-separated: discover, scout, telegram, notion, enrich, score, auto_kits, insights,
# google_jobs, mail — or "all" for the core crawl + digest only.
JOB_PILOTTO_DISABLE=
# Companies scout never suggests (e.g. your current employer), comma-separated.
JOB_PILOTTO_EXCLUDED_COMPANIES=

# --- Optional cosmetic/behavioral overrides ---
DIGEST_BRAND_NAME=
JOB_PILOTTO_CV_PATH=
JOB_PILOTTO_ENRICH_MODEL=
JOB_PILOTTO_SCORE_MODEL=
JOB_PILOTTO_KIT_MODEL=
