{
  "name": "main: pull requests with required checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [
    {"actor_id": null, "actor_type": "OrganizationAdmin", "bypass_mode": "pull_request"},
    {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "pull_request"}
  ],
  "rules": [
    {"type": "pull_request", "parameters": {"allowed_merge_methods": ["squash"], "dismiss_stale_reviews_on_push": false, "require_code_owner_review": false, "require_last_push_approval": false, "required_approving_review_count": 0, "required_review_thread_resolution": false}},
    {"type": "required_status_checks", "parameters": {"do_not_enforce_on_create": false, "strict_required_status_checks_policy": false, "required_status_checks": [{"context": "All checks passed"}]}},
    {"type": "non_fast_forward"},
    {"type": "deletion"}
  ]
}
